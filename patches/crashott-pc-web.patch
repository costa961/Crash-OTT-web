diff --git a/runtime/audio/xma.cpp b/runtime/audio/xma.cpp
--- a/runtime/audio/xma.cpp
+++ b/runtime/audio/xma.cpp
@@ -1022,3 +1022,18 @@
         memset(g_memory.Translate(h.guest), 0, CONTEXT_SIZE);
     }
 }
+
+#if defined(CRASH_WEB)
+namespace xma
+{
+    // WebAssembly has no write trap: the recompiled code calls this (runtime/mmio_wasm.cpp) after a
+    // 32-bit store to the register window has landed, the same report XmaMmioHandler makes on PC.
+    void OnGuestStore(uint32_t guest)
+    {
+        if (guest < TRAPPED_PAGE || guest >= TRAPPED_PAGE + 0x1000)
+            return;
+        guest &= ~3u;
+        OnRegisterWrite((guest - XMA_MMIO_BEGIN) / 4, *reinterpret_cast<uint32_t*>(g_memory.Translate(guest)));
+    }
+}
+#endif
