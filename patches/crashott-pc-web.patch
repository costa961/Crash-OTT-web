+    // report MmioHandler makes on PC (wakes the command processor on CP_RB_WPTR).
+    void OnGuestStore(uint32_t guest)
+    {
+        if (guest < GPU_MMIO_BEGIN || guest >= GPU_MMIO_BEGIN + 0x1000)
