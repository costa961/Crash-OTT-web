+#if defined(__wasm__)
+// WebAssembly: guest address == linear memory address, and linear memory can't map one page at two
+// addresses. The console's physical memory is seen at 0xA0000000 and again at 0xC0000000 (the
+// title's D3D uses both), so every guest access folds 0xC0000000-0xDFFFFFFF onto 0xA0000000.
+// `base` is an empty object whose operator+ does that: it covers the PPC_LOAD/STORE macros and the
+// recompiler's direct `base + ea` (vector loads/stores, reservations, setjmp...) alike, and an empty
+// struct argument costs nothing in the wasm C++ ABI. It converts to and from uint8_t* (address 0)
+// for the runtime's code.
+inline uint8_t* PPCGuestToHost(uint32_t address)
+{
+    return reinterpret_cast<uint8_t*>(uintptr_t(address - ((address >> 29) == 6 ? 0x20000000u : 0u)));
+}
+
+struct PPCBase
+{
+    PPCBase() = default;
+    PPCBase(uint8_t*) {}
+    operator uint8_t*() const { return nullptr; }
+    template <typename T, typename = std::enable_if_t<std::is_integral_v<T>>>
+    uint8_t* operator+(T offset) const { return PPCGuestToHost(uint32_t(offset)); }
+};
+
+// No page protection in WebAssembly, so the hardware register windows can't trap stores as on PC
+// (the GPU's at 0x7FC80000, the XMA decoder's at 0x7FEA0000: write-1 kick/lock/clear registers).
+// Every 32-bit guest store into 0x7FC00000-0x7FFFFFFF calls the runtime after it lands
+// (runtime/mmio_wasm.cpp): one compare per store, predicted not taken.
+extern "C" void PPCMmioStore(uint32_t address);
+inline void PPCStoreU32(uint32_t address, uint32_t value)
+{
+    *(volatile uint32_t*)PPCGuestToHost(address) = __builtin_bswap32(value);
+    if ((address >> 22) == 0x1FFu) [[unlikely]]
+        PPCMmioStore(address);
+}
+#define PPC_STORE_U32(x, y) PPCStoreU32(uint32_t(x), uint32_t(y))
+
+#define PPC_FUNC(x) void x(PPCContext& __restrict ctx, PPCBase base)
+#define PPC_FUNC_PROLOGUE()
+#else
 #define PPC_FUNC(x) void x(PPCContext& __restrict ctx, uint8_t* base)
+#define PPC_FUNC_PROLOGUE() __builtin_assume(((size_t)base & 0x1F) == 0)
+#endif
 #define PPC_FUNC_IMPL(x) extern "C" PPC_FUNC(x)
 #define PPC_EXTERN_FUNC(x) extern PPC_FUNC(x)
 #define PPC_WEAK_FUNC(x) __attribute__((weak,noinline)) PPC_FUNC(x)
 
-#define PPC_FUNC_PROLOGUE() __builtin_assume(((size_t)base & 0x1F) == 0)
-
 #ifndef PPC_LOAD_U8
 #define PPC_LOAD_U8(x) *(volatile uint8_t*)(base + (x))
 #endif
