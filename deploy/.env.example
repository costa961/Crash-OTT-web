# Copy to .env (next to compose.yml) and fill in. .env stays on the server, never in the repository.
CRASHOTT_HOST=crash.example.com
# the players: name:password, separated by spaces (passwords without spaces). PRIVATE: only people who own the game.
CRASHOTT_USERS="player1:CHANGE_ME"
# keys the login cookies; openssl rand -hex 32
CRASHOTT_COOKIE_SECRET=CHANGE_ME
# your game folder (default.xex, *.rcf, shaders/)
CRASHOTT_GAME=/srv/crashott/game
